# ---------------------------------------------------------------------------
# Soldeazy 数据表链路
# ---------------------------------------------------------------------------

# 登录凭据（首次登录用）。之后 cookie 落盘复用，无需重复登录。
# 也可以不配：首次运行时用 soldeazy_open_login 打开有头浏览器手动登录一次。
# SOLDEAZY_USERNAME=
# SOLDEAZY_PASSWORD=

# 浏览器 profile（保存登录态）。
# 默认 = <cwd>/.soldeazy-data/profile。显式设置时，计划/审计目录自动变成
# 它的兄弟目录 soldeazy-plans。
# SOLDEAZY_PROFILE_DIR=

# Playwright 解压内核用的临时目录。默认 <cwd>/.soldeazy-data/temp
# SOLDEAZY_TEMP_DIR=

# 浏览器内核。按顺序尝试，前一个失败自动回退到下一个：
#   chrome -> chromium -> Playwright 默认
# 目标机器没装 Chrome 时，执行 `uv run playwright install chromium` 即可。
SOLDEAZY_BROWSER_CHANNEL=chrome

# 1 = 无头（推荐，日常零窗口）；0 = 有头，仅首次登录或人工介入时用
SOLDEAZY_HEADLESS=1

# 浏览器空闲多少秒后自动关闭、交还 profile 锁（默认 300）。
# 关掉浏览器不等于掉登录：cookie 会先落盘，下一个抢到锁的进程直接复用。
# 0 = 不自动释放（浏览器跟进程同寿命）。
# SOLDEAZY_BROWSER_IDLE_SECONDS=300

# 写工具总开关。默认关闭，读链路验证通过后再开。
SOLDEAZY_WRITE_ENABLED=0

# 单次导航超时（秒）
SOLDEAZY_NAVIGATION_TIMEOUT=45
